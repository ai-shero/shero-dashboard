PORT=3200

# Dashboard access (shared password gate). REQUIRED in production — the server
# refuses to boot without these when NODE_ENV=production.
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Turso (production DB) — leave blank to use local SQLite
TURSO_URL=
TURSO_TOKEN=

# Shopify Admin API
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_TOKEN=

# SHERO POS (bloom-pos) API base URL
POS_API_URL=https://your-pos.onrender.com

# Shopee Finance PIN (required to access My Income page)
SHOPEE_FINANCE_PIN=

# Auto-relogin credentials (optional) — scrapers/auto-login.js retries an
# unattended login when a platform session expires. Known-device profile means
# OTP is usually skipped; if OTP/captcha appears it falls back to `npm run login`.
LAZADA_EMAIL=
LAZADA_PASSWORD=
TIKTOK_EMAIL=
TIKTOK_PASSWORD=
SHOPEE_EMAIL=
SHOPEE_PASSWORD=
SHOPIFY_EMAIL=
SHOPIFY_PASSWORD=
